# user/group configuration (optional, defaults to 1000:1000)
# Set to the UID:GID of the user that should own recorded files on the host
# Find your UID/GID with: id -u / id -g
# UID=1000
# GID=1000

# app time zone (optional, defaults to UTC)
# The timeline's days, the clock and tapes' logs use it, whatever zone a viewer's device is in.
# Set it to where the cameras are. Recordings and the API use absolute times, so changing it
# later only changes how they are displayed.
# Common values: America/New_York, America/Los_Angeles, Europe/London, UTC
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# TZ=UTC

# authentication configuration (optional, defaults to /opt/tapes/passwords)
# PASSWORDS_PATH=/opt/tapes/passwords

# JWT_KEY is REQUIRED - used to sign authentication tokens
# Generate a secure random key with: pwgen -s 64 1
JWT_KEY=

# MediaMTX API password is REQUIRED
# Generate a secure random password with: pwgen -s 32 1
MEDIAMTX_PASS=

# jwt issuer (optional, defaults to 'tapes')
# Identifies the application that issued the token
# JWT_ISSUER=tapes

# debug logging (optional, defaults to false)
# set to true, 1, or yes to enable debug-level logging
# info and error messages are always displayed
# DEBUG=false

# In-memory playback clip budget in MiB (optional, defaults to 256)
# PLAYBACK_CACHE_MB=256

# RTSP source for on-demand camera snapshots.
# MEDIAMTX_RTSP_URL=rtsp://mediamtx:8554
